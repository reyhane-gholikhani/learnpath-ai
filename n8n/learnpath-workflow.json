        "path": "learnpath-generate",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "52d1aaf6-2d1f-4ff2-971d-1a83103d6f5e",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "b7d09814-cfad-4e90-af76-a62d3b1bf13d"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nlet data = body;\nif (typeof body.payload === 'string') {\n  try { data = JSON.parse(body.payload); } catch (e) { data = {}; }\n}\nconst g = data.goal || {};\nreturn [{ json: {\n  access_token: String(data.access_token || ''),\n  goal: {\n    title: String(g.title || '').slice(0, 150),\n    description: String(g.description || '').slice(0, 1000),\n    current_level: String(g.current_level || 'beginner'),\n    weekly_hours: Number(g.weekly_hours) || 5,\n    target_date: g.target_date || null\n  }\n} }];"
      },
      "id": "28c2221b-570b-46a5-8a8a-54b5c46f43e2",
      "name": "Parse Input",
      "type": "n8n-nodes-base.code",
