    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nlet data = body;\nif (typeof body.payload === 'string') {\n  try { data = JSON.parse(body.payload); } catch (e) { data = {}; }\n}\nconst r = data.revise || {};\nconst str = (v, n) => String(v || '').slice(0, n);\nconst list = (v, max, len) => (Array.isArray(v) ? v : []).slice(0, max).map(x => str(x, len));\nconst done = (Array.isArray(r.completed_weeks) ? r.completed_weeks : []).slice(0, 12).map(w => ({\n  week: Number(w.week) || 0,\n  title: str(w.title, 150),\n  progress_percent: Number(w.progress_percent) || 0,\n  quiz_score: (w.quiz_score === null || w.quiz_score === undefined) ? null : Number(w.quiz_score),\n  unfinished_topics: list(w.unfinished_topics, 8, 200)\n}));\nconst rest = (Array.isArray(r.remaining_weeks) ? r.remaining_weeks : []).slice(0, 12).map(w => ({\n  week: Number(w.week) || 0,\n  title: str(w.title, 150),\n  objectives: list(w.objectives, 5, 200),\n  topics: list(w.topics, 8, 200),\n  practice: str(w.practice, 300),\n  resources: list(w.resources, 4, 200)\n}));\nreturn [{ json: {\n  access_token: String(data.access_token || ''),\n  revise: {\n    path_title: str(r.path_title, 150),\n    level: str(r.level || 'beginner', 30),\n    weekly_hours: Number(r.weekly_hours) || 5,\n    target_date: r.target_date || null,\n    completed_weeks: done,\n    remaining_weeks: rest\n  }\n} }];"
      },
