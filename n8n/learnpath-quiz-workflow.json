        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"questions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"question\": {\n            \"type\": \"string\"\n          },\n          \"options\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"correct_index\": {\n            \"type\": \"integer\"\n          },\n          \"explanation\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"question\",\n          \"options\",\n          \"correct_index\",\n          \"explanation\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"questions\"\n  ]\n}"
