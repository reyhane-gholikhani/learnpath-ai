    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nlet data = body;\nif (typeof body.payload === 'string') {\n  try { data = JSON.parse(body.payload); } catch (e) { data = {}; }\n}\nconst q = data.quiz || {};\nconst list = (v, max, len) => (Array.isArray(v) ? v : []).slice(0, max).map(x => String(x).slice(0, len));\nreturn [{ json: {\n  access_token: String(data.access_token || ''),\n  quiz: {\n    path_title: String(q.path_title || '').slice(0, 150),\n    week_title: String(q.week_title || '').slice(0, 150),\n    level: String(q.level || 'beginner'),\n    topics: list(q.topics, 12, 200),\n    objectives: list(q.objectives, 8, 200),\n    num_questions: Math.min(Math.max(Number(q.num_questions) || 5, 3), 10)\n  }\n} }];"
      },
      "id": "5a3eeb46-d05c-4330-82da-e5f85efb7d6c",
